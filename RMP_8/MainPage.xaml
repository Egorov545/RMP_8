<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RMP_8.MainPage"
             Title="Данные студента">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label FontSize="24" 
                   HorizontalTextAlignment="Center" 
                   Text="Просмотр данных студента"/>

            <Image x:Name="studentPhoto" 
                   Source="man.jpg" 
                   HeightRequest="200" 
                   WidthRequest="200" 
                   HorizontalOptions="Center"/>

            <Border BackgroundColor="#E3F2FD" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Персональные данные:" 
                           FontAttributes="Bold" 
                           FontSize="18"/>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="ФИО:" FontAttributes="Bold" WidthRequest="120"/>
                        <Label x:Name="fullNameLabel" Text="Не указано"/>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="Пол:" FontAttributes="Bold" WidthRequest="120"/>
                        <Label x:Name="genderLabel" Text="Не указан"/>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="Дата рождения:" FontAttributes="Bold" WidthRequest="120"/>
                        <Label x:Name="birthDateLabel" Text="Не указана"/>
                    </StackLayout>
                                        
                    <StackLayout Orientation="Horizontal">
                        <Label Text="Общежитие:" FontAttributes="Bold" WidthRequest="120"/>
                        <Label x:Name="dormitoryLabel" Text="Не указано"/>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="Староста:" FontAttributes="Bold" WidthRequest="120"/>
                        <Label x:Name="monitorLabel" Text="Не указано"/>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="Математика:" FontAttributes="Bold" WidthRequest="120"/>
                        <Label x:Name="mathGradeLabel" Text="Не указана"/>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal">
                        <Label Text="Русский язык:" FontAttributes="Bold" WidthRequest="120"/>
                        <Label x:Name="russianGradeLabel" Text="Не указана"/>
                    </StackLayout>
                </StackLayout>
            </Border>

            <StackLayout Orientation="Horizontal" 
                         Spacing="10" 
                         HorizontalOptions="Center" 
                         Margin="0,20">
                <Button x:Name="editButton" 
                        Text="Редактировать данные" 
                        Clicked="OnEditClicked"                         
                        WidthRequest="200"/>

                <Button x:Name="logoutButton" 
                        Text="Выйти" 
                        Clicked="OnLogoutClicked" 
                        BackgroundColor="Red" 
                        TextColor="White" 
                        WidthRequest="100"/>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>